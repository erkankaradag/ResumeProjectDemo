@model ResumeProjectDemo.Entities.Experience
@{
    ViewData["Title"] = "UpdateExperience";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="flex-1 overflow-y-auto p-8">
    <div class="max-w-6xl mx-auto space-y-8">

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="/Experience/ExperienceList/"
                   class="flex items-center justify-center w-10 h-10 rounded-lg border border-slate-200 dark:border-[#3b4d54]
                          hover:bg-slate-50 dark:hover:bg-[#1c2427] transition-colors">
                    <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                </a>

                <div>
                    <h3 class="text-3xl font-black tracking-tight">Deneyim Güncelle</h3>
                    <p class="text-slate-500 dark:text-[#9db2b9] mt-1">
                        Deneyim bilgilerinizi düzenleyin ve sağ tarafta önizleyin.
                    </p>
                </div>
            </div>

            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-primary/15 dark:bg-primary/20 text-primary">
                <span class="material-symbols-outlined text-[16px]">bolt</span>
                Live Preview
            </span>
        </div>

        <form method="post" class="grid grid-cols-1 lg:grid-cols-5 gap-6">

            <!-- LEFT: Form -->
            <div class="lg:col-span-3 bg-white dark:bg-[#111618] rounded-xl border border-slate-200 dark:border-[#3b4d54] overflow-hidden shadow-sm">

                <div class="p-6 border-b border-slate-200 dark:border-[#3b4d54]">
                    <h4 class="text-lg font-black tracking-tight">Bilgiler</h4>
                    <p class="text-sm text-slate-500 dark:text-[#9db2b9] mt-1">
                        Alanları düzenleyip kaydedin.
                    </p>
                </div>

                <div class="p-6 space-y-5">
                    <input type="hidden" asp-for="ExperienceId" />

                    <!-- Title -->
                    <div class="space-y-2">
                        <label for="title"
                               class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#9db2b9]">
                            Şirket Adı - Ünvan <span class="text-red-500">*</span>
                        </label>
                        <input id="title"
                               asp-for="Title"
                               class="w-full rounded-lg border border-slate-200 dark:border-[#3b4d54]
                                      bg-white dark:bg-[#0f1416] px-4 py-3 text-sm font-semibold
                                      placeholder:text-slate-400 dark:placeholder:text-[#6f8790]
                                      focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all"
                               placeholder="Örn: ABC Şirketi - Backend Developer"
                               required />
                    </div>

                    <!-- WorkDate -->
                    <div class="space-y-2">
                        <label for="workDate"
                               class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#9db2b9]">
                            Çalışma Tarihi <span class="text-red-500">*</span>
                        </label>
                        <input id="workDate"
                               asp-for="WorkDate"
                               class="w-full rounded-lg border border-slate-200 dark:border-[#3b4d54]
                                      bg-white dark:bg-[#0f1416] px-4 py-3 text-sm font-semibold
                                      placeholder:text-slate-400 dark:placeholder:text-[#6f8790]
                                      focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all"
                               placeholder="Örn: 2020 - 2023"
                               required />
                    </div>

                    <!-- Description -->
                    <div class="space-y-2">
                        <label for="description"
                               class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#9db2b9]">
                            Açıklama <span class="text-red-500">*</span>
                        </label>
                        <textarea id="description"
                                  asp-for="Description"
                                  rows="7"
                                  class="w-full rounded-lg border border-slate-200 dark:border-[#3b4d54]
                                         bg-white dark:bg-[#0f1416] px-4 py-3 text-sm font-semibold
                                         placeholder:text-slate-400 dark:placeholder:text-[#6f8790]
                                         focus:outline-none focus:ring-2 focus:ring-primary/40 transition-all resize-none"
                                  placeholder="Pozisyon hakkında detaylı bilgi, görev ve sorumluluklar..."
                                  required></textarea>

                        <div class="flex items-center justify-between text-xs text-slate-500 dark:text-[#9db2b9]">
                            <span>İpucu: 2-4 cümle ideal.</span>
                            <span id="charCount">0 karakter</span>
                        </div>
                    </div>

                    <!-- Info -->
                    <div class="rounded-xl border border-slate-200 dark:border-[#3b4d54] bg-slate-50/30 dark:bg-[#1c2427]/30 p-4">
                        <div class="flex gap-3">
                            <span class="material-symbols-outlined text-primary text-[22px]">info</span>
                            <div>
                                <p class="text-sm font-bold">Bilgilendirme</p>
                                <p class="text-xs text-slate-500 dark:text-[#9db2b9] mt-1">
                                    Kaydet dediğinizde güncel bilgiler listede görünecektir.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="p-6 border-t border-slate-200 dark:border-[#3b4d54] flex items-center justify-between">
                    <a href="/Experience/ExperienceList/"
                       class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 dark:border-[#3b4d54]
                              text-sm font-bold text-slate-700 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-white/5 transition-colors">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                        İptal
                    </a>

                    <button type="submit"
                            class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-background-dark rounded-lg font-black text-sm hover:opacity-90 transition-opacity">
                        <span class="material-symbols-outlined text-[20px]">save</span>
                        Güncellemeyi Kaydet
                    </button>
                </div>
            </div>

            <!-- RIGHT: Live Preview -->
            <div class="lg:col-span-2 bg-white dark:bg-[#111618] rounded-xl border border-slate-200 dark:border-[#3b4d54] overflow-hidden shadow-sm">
                <div class="p-6 border-b border-slate-200 dark:border-[#3b4d54]">
                    <h4 class="text-lg font-black tracking-tight">Önizleme</h4>
                    <p class="text-sm text-slate-500 dark:text-[#9db2b9] mt-1">
                        Form değiştikçe anında güncellenir.
                    </p>
                </div>

                <div class="p-6 space-y-5">
                    <div class="rounded-xl border border-slate-200 dark:border-[#3b4d54] bg-slate-50/30 dark:bg-[#0f1416] p-5 space-y-4">

                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-primary text-[26px]">work</span>
                            <div class="flex-1">
                                <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#9db2b9]">
                                    Şirket - Ünvan
                                </p>
                                <p id="previewTitle" class="text-lg font-black mt-1">—</p>
                            </div>
                        </div>

                        <div class="flex items-center justify-between rounded-lg border border-slate-200 dark:border-[#3b4d54] bg-white dark:bg-[#111618] px-4 py-3">
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#9db2b9]">
                                    Çalışma Tarihi
                                </p>
                                <p id="previewWorkDate" class="text-sm font-semibold mt-1">—</p>
                            </div>
                            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-primary/15 dark:bg-primary/20 text-primary">
                                <span class="material-symbols-outlined text-[16px]">schedule</span>
                                Timeline
                            </span>
                        </div>

                        <div class="space-y-1">
                            <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#9db2b9]">
                                Açıklama
                            </p>
                            <p id="previewDescription" class="text-sm text-slate-600 dark:text-[#c7d7dc] leading-relaxed">
                                —
                            </p>
                        </div>

                        <div class="pt-1 flex items-center justify-between">
                            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-primary/15 dark:bg-primary/20 text-primary">
                                <span class="material-symbols-outlined text-[16px]">edit</span>
                                Update Preview
                            </span>

                            <span id="previewQuality"
                                  class="text-[11px] font-bold text-slate-500 dark:text-[#9db2b9]">
                                —
                            </span>
                        </div>
                    </div>

                    <div class="rounded-xl border border-slate-200 dark:border-[#3b4d54] bg-slate-50/30 dark:bg-[#1c2427]/30 p-4">
                        <div class="flex gap-3">
                            <span class="material-symbols-outlined text-[22px] text-primary">tips_and_updates</span>
                            <div>
                                <p class="text-sm font-bold">İpucu</p>
                                <p class="text-xs text-slate-500 dark:text-[#9db2b9] mt-1">
                                    Değişiklikleri kaydetmeden önce önizlemeden kontrol edin.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </form>
    </div>
</div>

<script>
    const titleEl = document.getElementById("title");
    const workDateEl = document.getElementById("workDate");
    const descEl = document.getElementById("description");

    const previewTitle = document.getElementById("previewTitle");
    const previewWorkDate = document.getElementById("previewWorkDate");
    const previewDescription = document.getElementById("previewDescription");
    const charCount = document.getElementById("charCount");
    const previewQuality = document.getElementById("previewQuality");

    function refreshPreview() {
        const t = (titleEl.value || "").trim();
        const w = (workDateEl.value || "").trim();
        const d = (descEl.value || "").trim();

        previewTitle.textContent = t.length ? t : "—";
        previewWorkDate.textContent = w.length ? w : "—";
        previewDescription.textContent = d.length ? d : "—";

        const len = d.length;
        charCount.textContent = len + " karakter";

        if (len === 0) previewQuality.textContent = "Açıklama boş";
        else if (len < 60) previewQuality.textContent = "Kısa açıklama";
        else if (len < 160) previewQuality.textContent = "İdeal açıklama";
        else previewQuality.textContent = "Detaylı açıklama";
    }

    // İlk açılışta (model dolu geldiği için) önizlemeyi doldur
    refreshPreview();

    titleEl.addEventListener("input", refreshPreview);
    workDateEl.addEventListener("input", refreshPreview);
    descEl.addEventListener("input", refreshPreview);
</script>
